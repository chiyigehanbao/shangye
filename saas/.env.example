# ---------- FlowDesk 运行环境示例 ----------
# 复制为 .env 后修改。生产环境务必更换所有默认密码。

# 基础
APP_NAME=FlowDesk
APP_URL=https://flowdesk.example.com
ENV=production
HTTP_PORT=80

# 数据目录（Docker 内路径，通常不需要改）
DATA_DIR=/app/data
DATABASE_PATH=/app/data/flowdesk.db

# 平台管理员（首次启动创建；已有库不会覆盖密码）
ADMIN_EMAIL=admin@flowdesk.dev
ADMIN_PASSWORD=ChangeMe_Admin_2026
ADMIN_NAME=平台管理员

# 演示账号与示例数据
SEED_DEMO=1
DEMO_EMAIL=demo@flowdesk.dev
DEMO_PASSWORD=Demo@12345
DEMO_NAME=陈默
DEMO_WORKSPACE=星野工作室

# 会话
SESSION_DAYS=7
COOKIE_SECURE=0

# 上传
MAX_UPLOAD_MB=15
MAX_DOC_FILES=20

# 文档后台队列（2C2G 保持 1）
DOC_WORKERS=1
DOC_TASK_MAX_ATTEMPTS=3

# AI：auto = 云端 API → Ollama → 规则；2C2G 推荐 rules 或 auto
AI_MODE=auto
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5
AI_TIMEOUT=45

# 允许的跨站来源（一般留空，同源即可）
ALLOWED_ORIGINS=
